<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Govee Lights" Width="850" Height="770" MinWidth="730" MinHeight="540" WindowStartupLocation="CenterScreen"
 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F4F5F8" Background="#191C22" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#ABB3C0"/>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" Margin="2"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#697482" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button">
   <Setter Property="Width" Value="144"/><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="Background" Value="#343942"/><Setter Property="BorderBrush" Value="#525863"/>
   <Setter Property="Padding" Value="12,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="5" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A9BCCA"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C3DFFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#092638"/><Setter Property="Background" Value="#9FD5FD"/><Setter Property="BorderBrush" Value="#B9E3FF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="ContentTemplate" Value="{x:Null}"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="ContentTemplate" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="#272B32"/><Setter Property="BorderBrush" Value="#393E47"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="Slider"><Setter Property="Focusable" Value="True"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Slider"><Grid Height="30" Background="Transparent">
    <Border Height="4" Margin="6,0" VerticalAlignment="Center" Background="#626975" CornerRadius="2"/>
    <Track x:Name="PART_Track" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="4" Background="#9FD5FD" VerticalAlignment="Center" CornerRadius="2"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="19" Height="19"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse Fill="#353C46" Stroke="#697583"/><Ellipse Width="11" Height="11" Fill="#9FD5FD"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid></ControlTemplate>
  </Setter.Value></Setter></Style>
  <Style x:Key="WarmthSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}"><Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Slider"><Grid Height="30" Background="Transparent">
    <Border Height="12" Margin="9,0" VerticalAlignment="Center" CornerRadius="6"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FFA34A" Offset="0"/><GradientStop Color="#FFE4B4" Offset="0.32"/><GradientStop Color="#FFF9EE" Offset="0.57"/><GradientStop Color="#BCD5FF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
    <Track x:Name="PART_Track" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="20" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#272B32" BorderBrush="#F1F4F8" BorderThickness="2" CornerRadius="6" Margin="2,1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
  </Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#272B32"/><Setter Property="Foreground" Value="#F4F5F8"/><Setter Property="BorderBrush" Value="#525863"/></Style>
  <Style x:Key="Toggle" TargetType="CheckBox"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></Style.Triggers>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="38" Height="21" CornerRadius="11" Background="#363B43" BorderBrush="#ADB5C1" BorderThickness="1"><Ellipse x:Name="Knob" Width="11" Height="11" Margin="4,0" HorizontalAlignment="Left" Fill="#CDD4DD"/></Border><ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#9FD5FD"/><Setter TargetName="Knob" Property="Fill" Value="#182735"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="#191C22"><Grid.ColumnDefinitions><ColumnDefinition Width="167"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#16191E" BorderThickness="0,0,1,0" BorderBrush="#30343B">
   <Grid Margin="10,22,10,17"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,0,0,24" Orientation="Horizontal"><Canvas Width="27" Height="26"><Border Canvas.Left="1" Canvas.Top="5" Width="6" Height="19" Background="#9FD5FD" CornerRadius="3"/><Border Canvas.Left="12" Canvas.Top="1" Width="6" Height="19" Background="#AEC1FF" CornerRadius="3"/></Canvas><TextBlock Text="Govee Lights" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="NavLights" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,9,0"/><TextBlock Text="Lights"/></StackPanel></Button><Button x:Name="NavManual" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE793;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,9,0"/><TextBlock Text="Light controls"/></StackPanel></Button><Button x:Name="NavPresets" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,9,0"/><TextBlock Text="Presets"/></StackPanel></Button><Button x:Name="NavSync" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,9,0"/><TextBlock Text="Screen sync"/></StackPanel></Button><Button x:Name="NavSettings" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,9,0"/><TextBlock Text="Settings"/></StackPanel></Button></StackPanel>
    <StackPanel Grid.Row="2" Margin="8,0"><CheckBox x:Name="ToTray" Style="{StaticResource Toggle}" Content="Close to tray" ToolTip="Keep sync running when you close the window. Choose Quit in the system tray to exit." Margin="0,0,0,15"/>
     <TextBlock x:Name="CurrentModel" Text="Light status" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <Grid Margin="0,4,0,0" Height="20"><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center" HorizontalAlignment="Left" Fill="#878F9A"/><TextBlock x:Name="Connection" Grid.Column="1" Text="Searching" Margin="6,0,0,0" Padding="0" VerticalAlignment="Center" TextAlignment="Left" LineStackingStrategy="BlockLineHeight" LineHeight="15" Style="{StaticResource Small}"/></Grid></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="25,18,25,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,16"><TextBlock x:Name="Heading" Text="Screen sync" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="32"/>
    <Button x:Name="Refresh" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Refresh lights" AutomationProperties.Name="Refresh lights"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/></Button>
   </Grid>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid><StackPanel x:Name="LightsPage" Visibility="Collapsed">
     <TextBlock x:Name="SavedHeading" Text="Saved lights" Margin="0,10,0,8" FontWeight="SemiBold"/><StackPanel x:Name="SavedList"/>
     <Border x:Name="WelcomeCard" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="WelcomeTitle" Text="Set up your first light" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="Enable LAN Control for every light before searching." FontWeight="SemiBold"/>
      <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="In Govee Home, open a light → Settings (gear) → LAN Control → On. Repeat for each light. Connect the lights and this PC to the same home network." Style="{StaticResource Small}"/>
      <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="This app needs LAN Control to discover and operate a light. A model must offer that setting to connect here." Style="{StaticResource Small}"/>
      <Button x:Name="FindLights" Style="{StaticResource Primary}" Content="Find lights" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     <TextBlock x:Name="FoundHeading" Text="Discovered lights" Margin="0,10,0,8" FontWeight="SemiBold"/><StackPanel x:Name="FoundList"/>

    </StackPanel>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI apps &amp; notifications" FontWeight="SemiBold" FontSize="17"/>
      <CheckBox x:Name="AiEnabled" Style="{StaticResource Toggle}" Content="Allow local AI apps to control lights" Margin="0,14,0,6"/>
      <TextBlock x:Name="AiStatus" Style="{StaticResource Small}" TextWrapping="Wrap"/>
      <TextBlock Text="Only the lights selected below are available through MCP. Keep this app running, including in the tray." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,8"/>
      <StackPanel x:Name="AiLights"/>
      <CheckBox x:Name="AiWake" Style="{StaticResource Toggle}" Content="Let notifications wake lights that are off" Margin="0,12,0,0"/>
      <TextBlock Text="Green: complete · Amber: attention · Red: error · Blue: information. Signals restore lighting and resume interrupted screen sync." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <WrapPanel Margin="0,10,0,0"><Button x:Name="AiCopyConfig" Content="Copy MCP config" Margin="0,0,7,4"/><Button x:Name="AiTest" Content="Test notification" Margin="0,0,7,4"/><Button x:Name="AiStop" Content="Stop notification" IsEnabled="False"/></WrapPanel>
      <TextBlock Text="The Govee Lights plugin supports local desktop chats in ChatGPT/Codex. Web and cloud chats cannot reach this local server." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connect your lights" FontWeight="SemiBold" FontSize="17"/>
      <TextBlock Text="For each light, open Govee Home → select the light → Settings (gear) → LAN Control → On." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="Keep LAN Control enabled so the light can appear and respond in this app. The light and PC must be on the same home network." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <Button x:Name="SetupLights" Content="Find lights" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows sign-in" FontWeight="SemiBold" FontSize="17"/>
      <CheckBox x:Name="StartWindows" Style="{StaticResource Toggle}" Content="Start in the tray when I sign in" Margin="0,14,0,4"/>
      <TextBlock Style="{StaticResource Small}" Text="Open the app from its tray icon at any time." TextWrapping="Wrap"/>
      <Border Height="1" Background="#3B4049" Margin="0,14"/>
      <CheckBox x:Name="ResumeWindows" Style="{StaticResource Toggle}" Content="Resume selected screen-sync lights"/>
      <TextBlock Style="{StaticResource Small}" Text="Wait for all selected lights to be reachable, then start sync. This can turn on lights in your sync group." TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="PresetsPage" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Save current lighting" FontWeight="SemiBold" FontSize="17"/>
      <TextBlock Text="Choose lights and save their current power, brightness, and reported color or white temperature." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,10"/>
      <TextBox x:Name="PresetName" MaxLength="48" Padding="8,6" Background="#191C22" Foreground="White" BorderBrush="#555D69" AutomationProperties.Name="Preset name"/>
      <TextBlock Text="Preset name" Style="{StaticResource Small}" Margin="0,3,0,8"/>
      <StackPanel x:Name="PresetMembers"/><Button x:Name="SavePreset" Content="Save preset" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <StackPanel x:Name="PresetList"/>
    </StackPanel><StackPanel x:Name="SyncPage">
     <Border Style="{StaticResource Card}" Background="#222834" Padding="18,15,18,16">
      <StackPanel><Grid><TextBlock Text="Main display" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="Monitor" HorizontalAlignment="Right" Style="{StaticResource Small}"/></Grid>
       <Grid Height="164" Margin="0,8"><Grid.ClipToBounds>True</Grid.ClipToBounds>
        <Grid Width="266" Height="149" HorizontalAlignment="Center">
         <Border VerticalAlignment="Bottom" Background="#69727E" Width="7" Height="20" Margin="0,0,0,5"/><Border VerticalAlignment="Bottom" Background="#69727E" Width="57" Height="4" Margin="0,0,0,2" CornerRadius="2"/>
         <Border Height="125" Width="216" VerticalAlignment="Top" Margin="0,3,0,0" BorderThickness="2" BorderBrush="#8794A7" Background="#12161C" CornerRadius="5" Padding="4">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <Border x:Name="HalfL" Background="#263748" CornerRadius="2,0,0,2" Margin="0,0,1,0"/><Border x:Name="HalfR" Grid.Column="1" Background="#31384C" CornerRadius="0,2,2,0"/>
          </Grid></Border>
         <Border x:Name="BarL" Width="10" Height="112" Background="#788B9D" HorizontalAlignment="Left" CornerRadius="4" Margin="6,0,0,16"/><Border x:Name="BarR" Width="10" Height="112" Background="#788B9D" HorizontalAlignment="Right" CornerRadius="4" Margin="0,0,6,16"/>
        </Grid>
       </Grid>
       <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8"><TextBlock x:Name="ZoneLegend" Style="{StaticResource Small}" TextWrapping="Wrap" TextAlignment="Center"/><Button x:Name="PreviewDevice" Content="Next preview" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="SwatchL" Width="10" Height="10" Fill="#788B9D" Margin="0,0,7,0"/><TextBlock Text="Left half"/><TextBlock x:Name="HexL" Margin="8,0,0,0" Style="{StaticResource Small}"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse x:Name="SwatchR" Width="10" Height="10" Fill="#788B9D" Margin="0,0,7,0"/><TextBlock Text="Right half"/><TextBlock x:Name="HexR" Margin="8,0,0,0" Style="{StaticResource Small}"/></StackPanel>
       </Grid>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}"><DockPanel LastChildFill="True"><Button x:Name="Start" Style="{StaticResource Primary}" DockPanel.Dock="Right" Content="Start sync" Margin="12,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SyncState" Text="Sync is off" FontWeight="SemiBold"/><TextBlock x:Name="GroupSummary" Text="Choose lights to follow the main display." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="Comfort" FontWeight="SemiBold"/><TextBlock x:Name="ComfortValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="Comfort" Minimum="0" Maximum="100" Value="35" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" AutomationProperties.Name="Screen sync Comfort intensity"/>
      <TextBlock Text="Softens bright peaks and strong colors without a fade delay. Use 0% and Full spectrum for accurate sampled colors." Style="{StaticResource Small}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,10,0,0"><Button x:Name="ColorRange" Content="Full spectrum ▾"/><TextBlock Text="Optional continuous warm or cool color range" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></WrapPanel>
     </StackPanel></Border>
     <Border x:Name="PlacementCard" Style="{StaticResource Card}"><StackPanel>
      <DockPanel><Button x:Name="Test" Content="Test sides" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Bar placement" FontWeight="SemiBold"/><TextBlock Text="Test for red on the left and blue on the right." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,3,0,0"/></StackPanel></DockPanel>
      <Border Height="1" Background="#3B4049" Margin="0,13"/>
      <WrapPanel><CheckBox x:Name="Swap" Style="{StaticResource Toggle}" Content="Swap sides" VerticalAlignment="Center" Margin="0,3,22,3"/><Button x:Name="ZoneCount" Content="6 zones / bar ▾" ToolTip="Choose 1, 2, 3, or 6 sampled regions per bar"/></WrapPanel>
      <Expander Margin="0,9,0,0" Foreground="#BBC4CF" Header="Mounting options"><WrapPanel Margin="0,8,0,0">
       <CheckBox x:Name="FlipLeft" Style="{StaticResource Toggle}" Content="Flip left" Margin="0,4,10,4"/>
       <CheckBox x:Name="FlipRight" Style="{StaticResource Toggle}" Content="Flip right" Margin="0,4,10,4"/>
       <Button x:Name="Hardware" Content="6 segments / bar" ToolTip="Hardware segments per bar. Use 3 only for a three-segment hardware revision."/>
      </WrapPanel></Expander>
      <Expander Margin="0,9,0,0" Foreground="#BBC4CF" Header="Firmware compatibility"><StackPanel Margin="0,8,0,0">
       <CheckBox x:Name="ModeRefresh" Style="{StaticResource Toggle}" Content="Periodically re-enable streaming mode"/>
       <TextBlock Text="If your firmware stops following colors after about one minute, try enabling this. The refresh can cause a visible flash on some revisions." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel></Expander>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="ManualPage" Visibility="Collapsed">
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ControlTarget" Text="Choose a light or room" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="DeviceState" Margin="0,5,0,0" Style="{StaticResource Small}" Text="Waiting for device"/></StackPanel></Border>
     <Border x:Name="BarSetCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel>
      <TextBlock Text="Two-bar set" FontWeight="SemiBold"/>
      <WrapPanel Margin="0,8,0,8"><Button x:Name="BarChoice" Content="Both bars ▾"/><Button x:Name="ReleaseBars" Content="Release bars" Margin="6,0,0,0"/></WrapPanel>
      <TextBlock x:Name="BarStatus" Style="{StaticResource Small}" TextWrapping="Wrap"/>
      <TextBlock x:Name="BarMapping" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,5,0,0"/>
      <TextBlock Text="Individual control uses RGB; white-temperature scenes initialize the other bar at neutral white." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,5,0,0"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="On" Content="Turn on"/><Button x:Name="Off" Content="Turn off" Margin="6,0,0,0"/></StackPanel><TextBlock Text="Power" FontWeight="SemiBold"/></DockPanel></Border>
     <Border x:Name="BrightnessCard" Style="{StaticResource Card}"><StackPanel><Grid><TextBlock x:Name="BrightnessTitle" Text="Brightness" FontWeight="SemiBold"/><TextBlock x:Name="Percent" HorizontalAlignment="Right"/></Grid><Slider x:Name="Level" Margin="0,8,0,0" Minimum="1" Maximum="100" Value="50" TickFrequency="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" AutomationProperties.Name="Brightness"/><TextBlock x:Name="BrightnessHelp" Text="Adjusts live as you slide" Style="{StaticResource Small}"/></StackPanel></Border>
     <Border x:Name="ToneCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Color" FontWeight="SemiBold"/>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="WheelHost" Width="180" Height="180"/>
       <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"><TextBlock Text="Drag to choose a color" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Border x:Name="ColorSample" Height="26" Width="144" HorizontalAlignment="Left" Background="#84BFFF" CornerRadius="4" Margin="0,0,0,8"/>
        <TextBox x:Name="ColorInput" Text="#84BFFF" Width="144" Height="36" HorizontalAlignment="Left" MaxLength="7" Background="#1A1D23" Foreground="#F1F4F8" CaretBrush="#EEEEEE" BorderBrush="#687380" VerticalContentAlignment="Center" Padding="8,0" AutomationProperties.Name="Hex color"/>
        <Button x:Name="SetColor" Content="Apply hex color" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
     </StackPanel></Border>
     <Border x:Name="WarmthCard" Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="White warmth" FontWeight="SemiBold"/><TextBlock x:Name="Kelvin" HorizontalAlignment="Right"/></Grid>
